# ---------------------------------------------------------------------------
# SmartPrint frontend environment
# Copy to .env.local before running the app with a real backend.
# ---------------------------------------------------------------------------

# Base URL of the Node.js/Express API.
#
# Unset  -> http://localhost:5000 in development (the dev API default), and
#           same origin in production builds.
# Empty  -> same origin, for when the app is served by something that proxies
#           /api to the API (see the proxy in vite.config.js).
# Value  -> used verbatim, e.g. https://api.smartprint.in
#
# The health check always uses this URL. Business screens keep their sample data
# until the corresponding endpoints exist; see VITE_API_LIVE_DATA below.
VITE_API_BASE_URL=

# Opt-in switch for using the real API on business screens (shops, machines).
# Leave false until those endpoints are implemented and authenticated — enabling
# it now would replace working demo pages with 404s.
VITE_API_LIVE_DATA=false

# Dev-server proxy target for /api requests (see vite.config.js)
VITE_API_PROXY=http://127.0.0.1:5000

# Public origin used to build machine QR URLs, e.g. https://smartprint.in
# Falls back to window.location.origin when empty.
VITE_PUBLIC_ORIGIN=

# Payment gateway publishable key. TEST keys only in non-production builds.
# The current preview never initialises a gateway.
VITE_PAYMENT_KEY=
