# ---------------------------------------------------------------------------
# SmartPrint API — environment template
#
# Copy this file to server/.env and fill in real values.
#   cp server/.env.example server/.env
#
# NEVER commit server/.env. It is git-ignored.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# Port the API listens on. The Vite dev server proxies /api here.
PORT=5000

# Bind address. 0.0.0.0 keeps the API reachable from the dev server and from
# containerised/preview environments. Use 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0

# Max time to let in-flight requests finish during shutdown (ms)
SHUTDOWN_TIMEOUT_MS=10000

# --- Database --------------------------------------------------------------
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/smartprint
#
# MongoDB Atlas (replace user, password and cluster, and URL-encode the password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartprint?retryWrites=true&w=majority

# Fail fast rather than buffering for 10s when Mongo is unreachable
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=8000
MONGO_MAX_POOL_SIZE=10

# Optional: override the database name independently of the URI
# MONGO_DB_NAME=smartprint

# --- Frontend --------------------------------------------------------------
# Comma-separated list of allowed browser origins (CORS).
# Must match the origin the frontend is actually served from — scheme + host +
# port, no trailing slash. Comma-separated for more than one origin.
# REQUIRED in production: the API refuses to boot without it, because silently
# defaulting to localhost would break every real browser while looking healthy.
CLIENT_URL=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
# Set to true when the API sits behind a proxy/load balancer so req.ip is the
# real client address instead of the proxy's.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Public QR-portal bucket (per IP, per machine)
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug | off
LOG_LEVEL=info

# --- Phase 2 only ----------------------------------------------------------
# Temporary switch for admin-only routes that exist before authentication.
# When false (the default), POST /api/machines and /api/shops return 404.
# Phase 3 replaces this guard with JWT + role checks — remove this afterwards.
ALLOW_ANONYMOUS_ADMIN=false
