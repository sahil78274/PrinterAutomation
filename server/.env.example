# ---------------------------------------------------------------------------
# SmartPrint API — environment template
#
# Copy this file to server/.env and fill in real values.
#   cp server/.env.example server/.env
#
# NEVER commit server/.env. It is git-ignored.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# Port the API listens on. The Vite dev server proxies /api here.
PORT=5000

# Bind address. 0.0.0.0 keeps the API reachable from the dev server and from
# containerised/preview environments. Use 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0

# Max time to let in-flight requests finish during shutdown (ms)
SHUTDOWN_TIMEOUT_MS=10000

# --- Database --------------------------------------------------------------
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/smartprint
#
# MongoDB Atlas (replace user, password and cluster, and URL-encode the password):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartprint?retryWrites=true&w=majority

# Fail fast rather than buffering for 10s when Mongo is unreachable
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=8000
MONGO_MAX_POOL_SIZE=10

# Optional: override the database name independently of the URI
# MONGO_DB_NAME=smartprint

# --- Frontend --------------------------------------------------------------
# Comma-separated list of allowed browser origins (CORS).
# Must match the origin the frontend is actually served from — scheme + host +
# port, no trailing slash. Comma-separated for more than one origin.
# REQUIRED in production: the API refuses to boot without it, because silently
# defaulting to localhost would break every real browser while looking healthy.
CLIENT_URL=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
# Set to true when the API sits behind a proxy/load balancer so req.ip is the
# real client address instead of the proxy's.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Public QR-portal bucket (per IP, per machine)
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60

# --- Logging ---------------------------------------------------------------
# error | warn | info | debug | off
LOG_LEVEL=info

# --- Phase 2 only ----------------------------------------------------------
# Temporary switch for admin-only routes that exist before authentication.
# When false (the default), POST /api/machines and /api/shops return 404.
# Phase 3 replaces this guard with JWT + role checks — remove this afterwards.
ALLOW_ANONYMOUS_ADMIN=false

# First-admin bootstrap. POST /api/auth/bootstrap-admin requires this key;
# when unset, the route answers 404 and no admin can be created over HTTP.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_KEY=

# --- Authentication ------------------------------------------------------
# Secret key for signing JWT access tokens. MUST be at least 32 characters.
# REQUIRED in production. In development, an ephemeral secret is generated if unset.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access token lifetime (e.g. 15m, 1h, 7d)
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# Pepper for hashing refresh tokens (optional but recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_PEPPER=

# Password reset token lifetime in minutes
PASSWORD_RESET_TTL_MINUTES=30

# bcrypt cost factor (4 for tests, 12 for production)
BCRYPT_ROUNDS=12

# --- Email (SMTP) --------------------------------------------------------
# Configure SMTP to send password reset emails and notifications.
# When not configured, emails are logged to console in development.
# For production, all SMTP_* variables are required.

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="SmartPrint <noreply@smartprint.in>"

# Base URL for building password reset links (defaults to CLIENT_URL)
# APP_URL=https://smartprint.in

# --- File uploads --------------------------------------------------------
UPLOAD_MAX_BYTES=26214400
# UPLOAD_DIR=./storage/documents
DOCUMENT_RETENTION_HOURS=24

# --- Payments ------------------------------------------------------------
# "development" simulates payments. Production requires a real provider.
PAYMENT_PROVIDER=development
PLATFORM_FEE_BPS=600

# --- Real-time -----------------------------------------------------------
REALTIME_ENABLED=true
