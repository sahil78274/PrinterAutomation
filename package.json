{
  "name": "smartprint",
  "private": true,
  "version": "1.0.0",
  "description": "SmartPrint \u2014 QR-based automated self-service document printing platform",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/*.mjs\" \"*.{js,json,md}\" \"docs/*.md\"",
    "test:routes": "node scripts/smoke.mjs",
    "test:flow": "node scripts/flow-test.mjs",
    "test:a11y": "node scripts/a11y-check.mjs",
    "test:live-api": "node scripts/live-api-test.mjs",
    "test": "npm run lint && npm run test:routes && npm run test:flow && npm run test:a11y && npm run test:live-api",
    "test:acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11",
    "prettier": "^3.3.3"
  }
}
